[stream]

# Icecast server hostname or IP address.
host=stream.example.net

# Icecast source port.
port=8000

# Mount point presented by Icecast.
# A leading slash is optional.
mount=svxlink.mp3

# Icecast source password.
# Do not commit a real password to Git.
password=CHANGE_ME

# MP3 bitrate.
bitrate=32k

# Stream title shown by compatible players.
name=SvxLink TX
